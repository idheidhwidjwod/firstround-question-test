# Copy this file to .env and paste your keys after the = signs. Never commit .env.

# Google AI Studio, free: https://aistudio.google.com/apikey
# One key runs Gemini 2.5 Flash-Lite, Flash and Pro.
GEMINI_API_KEY=

# Groq, free: https://console.groq.com/keys
# Runs GPT-OSS 20B.
GROQ_API_KEY=

# Optional, Claude version only (npm run claude / npm run try-claude). Leave it empty to use your own Claude login.
# With a key here, the claude command runs with --bare and this key (billed per token, no account context at all).
# ANTHROPIC_API_KEY=

# Optional: another port than 8787
# PORT=8787
